{
  "deviceOrientation": "portrait",
  "showStatusBar": false,
  "openDataContext": "opencontext",
  "networkTimeout": {
    "request": 5000,
    "connectSocket": 5000,
    "uploadFile": 5000,
    "downloadFile": 5000
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "preview" },
      { "type": "folder", "value": ".tmpcheck" },
      { "type": "folder", "value": "tests" },
      { "type": "file", "value": "README.md" },
      { "type": "file", "value": "适龄等级自评.md" },
      { "type": "file", "value": "整体审计-游戏化改造方案-2026-08-31.md" },
      { "type": "file", "value": "跨平台审计报告-2026-08-30.md" },
      { "type": "file", "value": "跨平台审计报告-2026-09-02.md" },
      { "type": "file", "value": "自检报告-2026-08-30.md" },
      { "type": "folder", "value": "_bak_woodlv_before_replace" },
      { "type": "folder", "value": "_bak_firelv_before_replace" },
      { "type": "folder", "value": "_bak_waterlv_before_replace" },
      { "type": "folder", "value": ".trash_deadcode" },

      { "type": "file", "value": "src/imgb64.js" },
      { "type": "file", "value": "src/homebg.js" },
      { "type": "file", "value": "src/codexbg.js" },

      { "type": "file", "value": "battle/arenabg.js" }
    ]
  },
  "subpackages": [
    {
      "name": "battle",
      "root": "battle/"
    }
  ],
  "plugins": {},
  "preloadRule": {
    "battle/": { "packages": ["battle"], "network": "all" }
  },
  "resizable": false,
  "cursor": false,
  "renderOptions": {
    "antialias": true,
    "autoClear": true,
    "preserveDrawingBuffer": false
  }
}